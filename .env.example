# ReturnReady — Browser-facing Supabase connection configuration
# Copy this file to .env and fill in your dedicated ReturnReady Supabase project values.
# Authorization is enforced via Supabase Auth and PostgreSQL Row Level Security (RLS).
# NEVER place a service_role or secret key in any browser-facing variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility aliases (also supported by ReturnReady):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
